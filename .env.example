# Mwmbl API Credentials
# Copy this file to .env and fill in your credentials
# Or export these variables in your shell

# Your Mwmbl username (register at https://mwmbl.org/accounts/signup/)
MWMBL_USERNAME=your_username_here

# Your Mwmbl password
MWMBL_PASSWORD=your_password_here

# Usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your credentials
# 3. Source it: source .env
# 4. Run: make build-and-submit
